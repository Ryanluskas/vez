# Copie para .env e preencha. Este arquivo nunca vai pro Git.

# As mesmas duas chaves do painel (painel/.env.local).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# A MESMA conta que voce usa pra entrar no painel.
# E isso que amarra o WhatsApp desta maquina aos seus dados.
# O login acontece uma vez; depois o motor guarda a sessao em motor/sessao/.
VEZ_EMAIL=
VEZ_SENHA=

# --- IA ---
# Modelo local (decide, classifica, extrai fatos). Padrão: llama3.2:3b
OLLAMA_MODELO=llama3.2:3b

# Opcional: modelo grande só para REDIGIR a mensagem que o cliente lê.
# Sem isto, o local escreve — funciona, só sai mais duro.
# Valor, parcela e taxa nunca chegam aqui: a regra rígida corta antes.
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile

# Endereço do Ollama. Só mude se ele não roda nesta máquina.
# OLLAMA_URL=http://localhost:11434

# --- Ajustes finos (todos opcionais) ---

# O planejador deixa o modelo escolher o que consultar antes de responder.
# DESLIGADO por padrao: custa uma chamada do modelo local por resposta (12 a
# 46s medidos) pra buscar no manual, que ja entra inteiro em todo prompt.
# Ligue quando o manual ficar grande demais pra caber no prompt.
# VEZ_PLANEJADOR=1

# Escape hatch: quando o WhatsApp Web muda e quebra a lib, dá pra prender
# numa versão conhecida sem esperar release.
# WA_VERSAO_HTML=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.xxxxx.html

# Tempo limite do Ollama, em milissegundos.
# Pensar (classificar/extrair) e curto de proposito: com modelo quente
# isso leva 4 a 6 segundos, e passar disso significa que algo esta errado.
# OLLAMA_TIMEOUT_PENSAR_MS=12000
# OLLAMA_TIMEOUT_ESCREVER_MS=35000

# Deixa o Groq classificar quando o modelo local falhar.
# Desligado por padrao: essas chamadas veem a mensagem crua do cliente, e
# "as mensagens nao saem do seu computador" e o que voce vende. Ligar isso
# e escolher velocidade sobre essa promessa — e a escolha e sua.
# VEZ_PENSAR_NA_NUVEM=0

# Tempo limite do Groq. Medido: ~500ms pra escrever uma saudacao.
# Oito segundos sao quinze vezes isso — folga pra rede ruim, e curto o
# bastante pra ainda sobrar tempo de tentar o modelo local depois.
# GROQ_TIMEOUT_MS=8000
