# Copie para .env e preencha. Este arquivo nunca vai pro Git.

# As mesmas duas chaves do painel (painel/.env.local).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# A MESMA conta que voce usa pra entrar no painel.
# E isso que amarra o WhatsApp desta maquina aos seus dados.
# O login acontece uma vez; depois o motor guarda a sessao em motor/sessao/.
VEZ_EMAIL=
VEZ_SENHA=
