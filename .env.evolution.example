# ==============================================================================
# Evolution API v2 — Variáveis de Ambiente para Docker Compose
# Copie para .env.evolution e ajuste conforme necessário.
# ==============================================================================

# URL pública ou local da Evolution API
EVOLUTION_SERVER_URL=http://localhost:8080

# Chave mestra global da Evolution API (usada no header "apikey")
EVOLUTION_API_KEY=vez_evolution_api_key_capitalcred_2026

# Banco de dados exclusivo e dedicado da Evolution API (NÃO É O SUPABASE)
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution_user
EVOLUTION_DB_PASSWORD=evolution_secret_pass_2026

# Porta do webhook do Motor Vez (para onde a Evolution enviará eventos)
VEZ_WEBHOOK_URL=http://host.docker.internal:3333/webhook
VEZ_WEBHOOK_SECRET=vez_webhook_secret_capitalcred_2026
